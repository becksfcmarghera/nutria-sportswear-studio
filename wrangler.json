{
  "name": "nutria-sportswear-studio",
  "main": "cloudflare/dist/worker/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "cloudflare/dist/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/login",
      "/logout",
      "/bozze",
      "/progetti",
      "/studio",
      "/studio.html"
    ],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutria-sportswear-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nutria-sportswear-files"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "becksfcmarghera@gmail.com",
    "SITE_LABEL": "Nutria Sportswear Studio"
  }
}