{
  "name": "nutria-sportswear-studio",
  "main": "cloudflare/dist/worker/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "cloudflare/dist/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/login",
      "/logout",
      "/bozze",
      "/progetti",
      "/studio",
      "/studio.html",
      "/admin",
      "/admin/*",
      "/bozze/",
      "/manage.html",
      "/configura-admin.html"
    ],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutria-sportswear",
      "database_id": "bc652a02-922a-4179-9026-68acd7ea8332",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nutria-sportswear-files"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "becksfcmarghera@gmail.com",
    "SITE_LABEL": "Nutria Sportswear Studio",
    "NOTIFICATION_FORM_URL": "https://formsubmit.io/f/e2277192-01ac-4a19-bb66-770b5a075b74",
    "ACCESS_TEAM_DOMAIN": "https://frosty-salad-873a.cloudflareaccess.com",
    "ACCESS_AUD": "756a0b42a512a679cbb03b60440073e8c6ef2571c70599cd82dcd0cc9bda8e55"
  }
}
