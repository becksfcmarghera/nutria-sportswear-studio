{
  "name": "nutria-sportswear-studio",
  "main": "dist/worker/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/login",
      "/logout",
      "/bozze",
      "/progetti",
      "/studio",
      "/studio.html",
      "/admin",
      "/admin/*",
      "/bozze/",
      "/manage.html",
      "/configura-admin.html"
    ],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutria-sportswear",
      "database_id": "bc652a02-922a-4179-9026-68acd7ea8332"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nutria-sportswear-files"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "becksfcmarghera@gmail.com",
    "SITE_LABEL": "Nutria Sportswear Studio",
    "NOTIFICATION_FORM_URL": ""
  }
}
